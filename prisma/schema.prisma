// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  OWNER
  ADMIN
  ANALYST
  VIEWER
}

enum ResearchCaseStatus {
  ACTIVE
  ARCHIVED
}

enum SampleStatus {
  REGISTERED
  READY
  ARCHIVED
}

enum InputFileType {
  FASTQ
  BAM
  CRAM
  VCF
  GVCF
  BED
  OTHER
}

enum InputFileStatus {
  REGISTERED
  UPLOADING
  UPLOADED
  VALIDATING
  VALIDATED
  FAILED
}

model Organization {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime       @default(now())
  memberships Membership[]
  cases       ResearchCase[]
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique
  displayName  String
  createdAt    DateTime       @default(now())
  memberships  Membership[]
  createdCases ResearchCase[] @relation("CaseCreator")
}

model Membership {
  id             String         @id @default(uuid()) @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId         String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId String         @db.Uuid
  role           MembershipRole @default(ANALYST)
  createdAt      DateTime       @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model ResearchCase {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(255)
  description       String?            @db.VarChar(2000)
  externalReference String?            @db.VarChar(255)
  status            ResearchCaseStatus @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  organizationId    String             @db.Uuid
  creator           User               @relation("CaseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdByUserId   String             @db.Uuid
  samples           Sample[]

  @@unique([organizationId, externalReference])
  @@unique([organizationId, id])
  @@index([organizationId, createdAt, id])
}

model Sample {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  caseId         String       @db.Uuid
  externalId     String       @db.VarChar(255)
  sampleType     String       @db.VarChar(100)
  status         SampleStatus @default(REGISTERED)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  researchCase ResearchCase @relation(fields: [organizationId, caseId], references: [organizationId, id], onDelete: Restrict)

  inputFiles InputFile[]

  @@unique([organizationId, id])
  @@unique([organizationId, caseId, externalId])
  @@index([organizationId, caseId, createdAt, id])
}

model InputFile {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  sampleId       String          @db.Uuid
  fileName       String          @db.VarChar(255)
  fileType       InputFileType
  storageKey     String          @unique
  sizeBytes      BigInt?
  checksumSha256 String?         @db.VarChar(64)
  status         InputFileStatus @default(REGISTERED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  sample Sample @relation(fields: [organizationId, sampleId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, sampleId, createdAt, id])
}
